MARKETAUX_API_TOKEN=
YOUTUBE_API_KEY=
CURRENTS_API_KEY=
# Optional path to an existing saved news state (relative to backend cwd or absolute).
# Passed through the process environment; API does not load provider credentials.
NEWS_STATE_PATH=
# Optional existing saved video state. Pass through the process environment.
VIDEOS_STATE_PATH=
# Comma-separated exact origins, no trailing slash. No wildcard.
# Production example: https://YOUR-DISTRIBUTION.cloudfront.net
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
